{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm:watch",
      "type": "shell",
      "command": "npm run watch",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": "$tsc-watch"
    },
    {
      "label": "python:server",
      "type": "shell",
      "command": "${workspaceFolder}/server/.venv/Scripts/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "prepare-all",
      "dependsOn": ["npm:watch", "python:server"],
      "problemMatcher": []
    }
  ]
}