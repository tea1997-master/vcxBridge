{
  "name": "vcxbridge",
  "displayName": "vcxBridge",
  "version": "0.1.0",
  "description": "Visual Studio project (.vcxproj / .sln) analyzer for cpptools Configuration Provider and customizable build/task GUI",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.vcxproj"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vcxbridge.helloWorld",
        "title": "vcxBridge: Show Status"
      }
    ]
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "c++",
    "vcxproj",
    "msbuild",
    "cpptools",
    "intellisense"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
